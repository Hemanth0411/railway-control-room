# Railway Control Room — environment variables
# Copy to .env.local and fill in. Never commit real values.

# --- Railway OAuth app (created at railway.com, Web/confidential app type) ---
# Client secret is server-side only and must never reach browser JavaScript.
RAILWAY_OAUTH_CLIENT_ID=
RAILWAY_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Railway OAuth app.
# Local:      http://localhost:3000/api/auth/callback
# Production: https://<your-app>.up.railway.app/api/auth/callback
RAILWAY_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Session ---
# Key for the encrypted, httpOnly session cookie. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Application ---
# Public origin of this app. Used to build absolute URLs.
APP_BASE_URL=http://localhost:3000

# --- Sandbox ---
# Fixed Docker image deployed as the Sandbox service.
# Users cannot supply arbitrary images; this is the single application-owned image.
SANDBOX_IMAGE=
